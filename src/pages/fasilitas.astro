---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageHero, getSiteSettings, listFacilities } from '../lib/content';

const site = getSiteSettings();
const hero = getPageHero('fasilitas');
const facilities = listFacilities(true);
---

<BaseLayout
  title="Fasilitas"
  description={`Fasilitas pendukung pembelajaran dan kehidupan asrama di ${site.name}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p>{hero.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {
          facilities.map((item, i) => (
            <article class="feature-item">
              {item.image && <img src={item.image} alt="" class="feature-thumb" loading="lazy" />}
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3><a href={`/fasilitas/${item.slug}`}>{item.title}</a></h3>
              <p>{item.description}</p>
              <p><a class="btn btn-outline-dark" href={`/fasilitas/${item.slug}`}>Detail fasilitas</a></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-thumb {
    width: 100%;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
</style>
