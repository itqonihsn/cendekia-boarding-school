---
import BaseLayout from '../layouts/BaseLayout.astro';
import { facilities, site } from '../data/site';
---

<BaseLayout
  title="Fasilitas"
  description={`Fasilitas pendukung pembelajaran dan kehidupan asrama di ${site.name}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Lingkungan Belajar</span>
      <h1>Fasilitas Pesantren</h1>
      <p>Sarana yang mendukung ibadah, belajar, istirahat, dan pengembangan potensi santri.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {
          facilities.map((item, i) => (
            <article class="feature-item">
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
