---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getHomeContent,
  getSiteSettings,
  listNews,
  listPrograms,
} from '../lib/content';

const site = getSiteSettings();
const home = getHomeContent();
const programs = listPrograms(true);
const news = listNews(true).slice(0, 3);
const heroHasPhoto = Boolean(home.heroImage);
---

<BaseLayout
  title={`${site.name} | Pendidikan Islam Unggul`}
  description="Website resmi Cendekia Boarding School — Pesantren Modern Terpadu di bawah Yayasan Syarif Muslih Institute."
>
  <section class="home-hero">
    <div class="hero-media" class:list={[{ 'has-photo': heroHasPhoto }]} style={heroHasPhoto ? `--hero-photo:url('${home.heroImage}')` : undefined} aria-hidden="true"></div>
    <div class="container hero-content">
      <img class="hero-logo" src={site.logo} alt={site.name} width="140" height="140" />
      <p class="brand-signal">{site.name}</p>
      <p class="brand-foundation">{site.foundation}</p>
      <h1>{home.heroTitle} <em>{home.heroEmphasis}</em> &amp; Berakhlak</h1>
      <p>{home.heroLead}</p>
      <div class="hero-actions">
        <a class="btn btn-yellow" href="/program">Lihat Program</a>
        <a class="btn btn-outline" href="/kontak">Info Pendaftaran</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">{home.foundationEyebrow}</span>
        <h2>{home.foundationTitle}</h2>
        <p class="lead">{home.foundationLead}</p>
      </div>
      <div class="feature-grid">
        {
          home.pillars.map((pillar, i) => (
            <article class="feature-item">
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3>{pillar.title}</h3>
              <p>{pillar.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="quote-band">
    <div class="container">
      <p>{home.quoteText}</p>
      <cite>{home.quoteCite}</cite>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="panel" role="img" aria-label="Logo Cendekia Boarding School">
        <img class="panel-logo" src={site.logo} alt="" />
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">{home.aboutEyebrow}</span>
          <h2>{home.aboutTitle}</h2>
          <p class="lead">{home.aboutLead}</p>
        </div>
        <ul class="check-list">
          {home.aboutBullets.map((item) => <li>{item}</li>)}
        </ul>
        <p style="margin-top: 1.5rem">
          <a class="btn btn-primary" href="/tentang">Selengkapnya</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Program</span>
        <h2>Program Unggulan</h2>
      </div>
      <div class="feature-grid">
        {
          programs.slice(0, 3).map((item, i) => (
            <article class="feature-item">
              {item.image && <img src={item.image} alt="" class="feature-thumb" loading="lazy" />}
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3><a href={`/program/${item.slug}`}>{item.title}</a></h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
      <p class="text-center-actions" style="margin-top:1.75rem">
        <a class="btn btn-outline-dark" href="/program">Semua Program</a>
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Berita</span>
        <h2>Kegiatan Terbaru</h2>
      </div>
      <div class="news-grid">
        {
          news.map((item) => (
            <article class="news-item">
              {item.coverImage && <img src={item.coverImage} alt="" class="news-cover" loading="lazy" />}
              <div class="news-meta">
                <span>{item.category}</span>
                <span>{item.publishedAt}</span>
              </div>
              <h3><a href={`/berita/${item.slug}`}>{item.title}</a></h3>
              <p>{item.excerpt}</p>
            </article>
          ))
        }
      </div>
      <p class="text-center-actions" style="margin-top:1.75rem">
        <a class="btn btn-outline-dark" href="/berita">Lihat Berita</a>
      </p>
    </div>
  </section>

  <section class="quote-band">
    <div class="container">
      <p>{home.ctaQuote}</p>
      <p style="margin-top: 1.25rem">
        <a class="btn btn-outline" href="/kontak">{home.ctaButton}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: min(88vh, 760px);
    min-height: min(88dvh, 760px);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: white;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(20, 90, 31, 0.94) 0%, rgba(36, 155, 48, 0.78) 48%, rgba(46, 175, 58, 0.45) 100%),
      radial-gradient(circle at 78% 30%, rgba(255, 230, 0, 0.35), transparent 35%),
      linear-gradient(145deg, #145a1f, #2eaf3a 55%, #3ec04a);
  }

  .hero-media.has-photo {
    background:
      linear-gradient(105deg, rgba(20, 90, 31, 0.88) 0%, rgba(36, 155, 48, 0.72) 48%, rgba(46, 175, 58, 0.5) 100%),
      var(--hero-photo) center/cover no-repeat,
      linear-gradient(145deg, #145a1f, #2eaf3a 55%, #3ec04a);
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M40 8l6 14h15l-12 9 5 14-14-9-14 9 5-14-12-9h15z' fill='none' stroke='rgba(255,230,0,0.14)' stroke-width='1'/%3E%3C/svg%3E");
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: calc(7rem + env(safe-area-inset-top)) 0 4.5rem;
    max-width: 40rem;
    margin-left: max(1rem, calc((100% - var(--container)) / 2));
    margin-right: auto;
    width: min(40rem, calc(100% - 2rem));
    animation: rise 0.8s ease both;
  }

  .hero-logo {
    width: clamp(96px, 28vw, 140px);
    height: auto;
    aspect-ratio: 819 / 788;
    object-fit: contain;
    margin-bottom: 1rem;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.28));
  }

  .brand-signal {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3.2vw, 2.1rem);
    color: var(--yellow-400);
    letter-spacing: 0.02em;
  }

  .brand-foundation {
    margin: 0.25rem 0 1rem;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .hero-content h1 {
    color: white;
    font-size: clamp(2.4rem, 6vw, 4rem);
    max-width: 12ch;
    margin-bottom: 1rem;
  }

  .hero-content h1 em {
    font-style: normal;
    color: var(--yellow-400);
  }

  .hero-content > p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.08rem;
    max-width: 32em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .feature-thumb,
  .news-cover {
    width: 100%;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
    aspect-ratio: 16/10;
    object-fit: cover;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 700px) {
    .home-hero {
      min-height: auto;
    }
    .hero-content {
      padding: calc(5rem + env(safe-area-inset-top)) 0 calc(2.75rem + env(safe-area-inset-bottom));
      margin-left: max(0.625rem, calc((100% - var(--container)) / 2));
      width: min(40rem, calc(100% - 1.25rem));
    }
    .hero-content h1 {
      max-width: none;
      font-size: clamp(2rem, 9vw, 2.75rem);
    }
    .brand-signal {
      font-size: clamp(1.2rem, 5vw, 1.45rem);
      line-height: 1.25;
    }
    .brand-foundation {
      font-size: 0.88rem;
      line-height: 1.4;
    }
    .hero-content > p {
      font-size: 1rem;
    }
    .hero-logo {
      width: min(32vw, 112px);
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
