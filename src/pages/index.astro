---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAchievements,
  getPpdbContent,
  getSchedule,
  getSiteSettings,
  getTestimonials,
  listFacilities,
  listPrograms,
} from '../lib/content';
import { waHref, waLinkAttrs, whatsappChatUrl } from '../lib/whatsapp';

const site = getSiteSettings();
const ppdb = getPpdbContent();
const waPendaftaran = whatsappChatUrl(
  site.phone,
  ppdb.waMessage ||
    `Assalamu'alaikum, saya ingin informasi pendaftaran santri baru TA ${ppdb.academicYear} di SMP Cendekia Boarding School.`,
);
const waHubungi = whatsappChatUrl(site.phone, `Assalamu'alaikum, saya ingin bertanya tentang CBS.`);
const facilities = listFacilities(true);
const schedule = getSchedule(true);
const testimonials = getTestimonials(true);
const programs = listPrograms(true).slice(0, 8);
const achievements = getAchievements(true).filter((a) => a.kind === 'external');
const phoneDisplay = site.phone.replace(/^\+62\s?/, '0').replace(/[\s-]/g, '');

const alur = [
  { title: 'Buat Akun', desc: 'Daftar dengan nomor WhatsApp wali' },
  { title: 'Isi Formulir', desc: 'Data santri, orang tua, asal sekolah' },
  { title: 'Bayar Pendaftaran', desc: 'Rp 250.000, konfirmasi otomatis' },
  { title: 'Unggah Berkas', desc: 'Akta, KK, rapor, pas foto' },
  { title: 'Seleksi', desc: 'Tes akademik, baca Al-Qur’an, wawancara' },
  { title: 'Pengumuman', desc: 'Hasil di akun dan WhatsApp' },
  { title: 'Daftar Ulang', desc: 'Lunasi uang masuk, jadwal masuk asrama' },
];

const fotoTiles = [
  { src: '/media/foto/halaqah.jpg', label: 'Halaqah Al-Qur’an' },
  { src: '/media/foto/ruang-kelas.jpg', label: 'Ruang kelas' },
  { src: '/media/foto/outing-class.jpg', label: 'Outing class' },
  { src: '/media/foto/bimbel.jpg', label: 'Bimbel intensif' },
];
---

<BaseLayout
  title={`SMP Cendekia Boarding School | PPDB ${ppdb.academicYear}`}
  description={`Penerimaan Santri Baru TA ${ppdb.academicYear}. ${ppdb.tagline}`}
>
  <div class="wrap" style="padding-top:8px">
    <section class="hero">
      <div>
        <div class="org">{site.foundation}</div>
        <h1>
          Penerimaan<br />Santri Baru
        </h1>
        <div class="ribbon">Tahun Ajaran {ppdb.academicYear}</div>
        <div class="script">{ppdb.tagline}</div>
        <p class="lead">
          Pesantren Modern Terpadu Cendekia — mendidik santri berkarakter ahli ibadah, berilmu, produktif, peduli, dan
          berjiwa pemimpin.
        </p>
        <div class="btn-row">
          <a class="btn btn-gold btn-lg" href={waHref(waPendaftaran)} {...waLinkAttrs(waPendaftaran)}>
            {ppdb.ctaLabel}
          </a>
          <a class="btn btn-ghost btn-lg" href="/kontak">Cek Status Pendaftaran</a>
        </div>
      </div>
      <div class="photo">
        <img src="/media/foto/gedung-sekolah.jpg" alt="Gedung SMP Cendekia Boarding School" />
        <div class="tag">
          <span>Kab. Bogor, Jawa Barat</span>
          Sekolah Menengah Pertama Islam
        </div>
      </div>
    </section>
  </div>

  {
    ppdb.open && (
      <div class="sec" id="biaya">
        <div class="wrap">
          <div class="prices">
            <div class="price alt">
              <span class="tt">{ppdb.registrationFeeLabel}</span>
              <strong>{ppdb.registrationFee}</strong>
              <small>Dibayar saat membuat akun pendaftar</small>
            </div>
            <div class="price">
              <span class="tt">{ppdb.entranceFeeLabel}</span>
              <strong>{ppdb.entranceFee.includes('7') ? 'Rp 7,5 Juta' : ppdb.entranceFee}</strong>
              <small>Satu kali, saat daftar ulang</small>
            </div>
            <div class="price">
              <span class="tt">{ppdb.sppFeeLabel}</span>
              <strong>{ppdb.sppFee.includes('1,45') || ppdb.sppFee.includes('1.45') ? 'Rp 1,45 Juta' : ppdb.sppFee}</strong>
              <small>{ppdb.sppNote || 'Pendidikan, makan, laundry'}</small>
            </div>
          </div>
          <p class="note">*) Syarat dan ketentuan berlaku</p>
        </div>
      </div>
    )
  }

  <div class="sec sky" id="alur" style="border-radius:var(--radius-xl)">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Alur Pendaftaran</span>
        <h2>7 langkah dari akun sampai masuk asrama</h2>
        <p>Alur ini usulan UI; sesuaikan dengan prosedur resmi panitia melalui admin.</p>
      </div>
      <div class="steps">
        {
          alur.map((step, i) => (
            <div class="step">
              <div class="num">{i + 1}</div>
              <b>{step.title}</b>
              <span>{step.desc}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="sec" id="gelombang">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Jadwal PPDB</span>
        <h2>Gelombang pendaftaran TA {ppdb.academicYear}</h2>
        <p>Tanggal dan kuota diisi panitia dari panel admin.</p>
      </div>
      <div class="wave">
        <div class="card now">
          <span class="pill">Sedang dibuka</span>
          <h3 style="margin-top:12px">Gelombang 1</h3>
          <p class="ph">dd mmm – dd mmm 2027</p>
          <p style="margin-top:8px">
            Kuota: <span class="ph">diisi panitia</span>
          </p>
          <p>
            Tes seleksi: <span class="ph">dd mmm 2027</span>
          </p>
          <p>
            Pengumuman: <span class="ph">dd mmm 2027</span>
          </p>
        </div>
        <div class="card">
          <span class="pill gold">Segera</span>
          <h3 style="margin-top:12px">Gelombang 2</h3>
          <p class="ph">dd mmm – dd mmm 2027</p>
          <p style="margin-top:8px">
            Kuota: <span class="ph">diisi panitia</span>
          </p>
          <p>
            Tes seleksi: <span class="ph">dd mmm 2027</span>
          </p>
          <p>
            Pengumuman: <span class="ph">dd mmm 2027</span>
          </p>
        </div>
        <div class="card">
          <span class="pill gold">Segera</span>
          <h3 style="margin-top:12px">Gelombang 3</h3>
          <p class="ph">dd mmm – dd mmm 2027</p>
          <p style="margin-top:8px">
            Kuota: <span class="ph">diisi panitia</span>
          </p>
          <p>
            Tes seleksi: <span class="ph">dd mmm 2027</span>
          </p>
          <p>
            Pengumuman: <span class="ph">dd mmm 2027</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="sec sky" style="border-radius:var(--radius-xl)">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Program Unggulan</span>
        <h2>Al Qur'annya Oke! Akademiknya Oke!</h2>
      </div>
      <div class="grid g4">
        {
          programs.map((item, i) => (
            <div class="card">
              <div class:list={['num', { gold: i % 2 === 1 }]}>{i + 1}</div>
              <h3>
                <a href={`/program/${item.slug}`}>{item.title}</a>
              </h3>
              <p>{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Fasilitas dan Sistem Pendukung</span>
        <h2>Lingkungan belajar yang aman dan hijau</h2>
      </div>
      <div class="tiles">
        {
          fotoTiles.map((tile) => (
            <div class="tile">
              <img src={tile.src} alt={tile.label} loading="lazy" />
              <span>{tile.label}</span>
            </div>
          ))
        }
      </div>
      <ol class="faclist">
        {facilities.map((f) => <li>{f.title}</li>)}
      </ol>
    </div>
  </div>

  {
    schedule.length > 0 && (
      <div class="sec sky" style="border-radius:var(--radius-xl)">
        <div class="wrap">
          <div class="sec-head">
            <span class="chip">Kehidupan Santri</span>
            <h2>Jadwal harian</h2>
          </div>
          <div class="sched">
            {schedule.map((row) => (
              <div class="r">
                <b>{row.time}</b>
                <span>{row.activity}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="sec">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Kata Wali Santri</span>
        <h2>Dipercaya orang tua santri</h2>
      </div>
      <div class="grid g3">
        {
          testimonials.map((item, i) => (
            <div class:list={['quote', { light: i === 1 }]}>
              <p>“{item.quote}”</p>
              <cite>
                {item.name}
                <span>{item.role}</span>
              </cite>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="sec sky" style="border-radius:var(--radius-xl)">
    <div class="wrap">
      <div class="sec-head">
        <span class="chip">Prestasi</span>
        <h2>Santri CBS berprestasi</h2>
      </div>
      <div class="grid g4" style="margin-bottom:20px">
        <div class="stat">
          <strong>26 juz</strong>
          <span>Hafalan Ananda Irsyad saat lulus SMP</span>
        </div>
        <div class="stat">
          <strong>7 emas</strong>
          <span>Medali Pencak Silat IPB Championship 2026</span>
        </div>
        <div class="stat">
          <strong>Juara 1</strong>
          <span>MHQ Nasional 5 juz, Kuwait 2024</span>
        </div>
        <div class="stat">
          <strong>12 buku</strong>
          <span>Dibaca Ananda Al Fikri dalam waktu setahun</span>
        </div>
      </div>
      <div class="card">
        <h3>Prestasi eksternal</h3>
        <ul class="alist">
          {achievements.map((a) => (
            <li>
              {a.title}
              {a.year ? ` (${a.year})` : ''}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="sec">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Siapkan putra-putri Anda menjadi generasi cendekia</h2>
          <p>
            Pendaftaran TA {ppdb.academicYear}
            {ppdb.open ? ' sedang dibuka' : ' — hubungi panitia untuk info terkini'}. Tim PPDB siap membantu lewat
            WhatsApp.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn-blue btn-lg" href={waHref(waPendaftaran)} {...waLinkAttrs(waPendaftaran)}>
            Daftar Sekarang
          </a>
          <a class="btn btn-line btn-lg" href={waHref(waHubungi)} {...waLinkAttrs(waHubungi)}>
            Hubungi {phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
