---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPeople } from '../../lib/content';

const items = getPeople();
const editId = Number(Astro.url.searchParams.get('edit') || 0);
const editing = items.find((i) => i.id === editId) || null;
---

<AdminLayout title="Pimpinan / SDM" active="people">
  <div class="admin-grid-2">
    <form class="form admin-card" method="POST" action="/api/admin/people">
      <input type="hidden" name="id" value={editing?.id || ''} />
      <h2 style="margin-top:0">{editing ? 'Edit profil' : 'Tambah profil'}</h2>
      <label>Nama<input type="text" name="name" value={editing?.name || ''} required /></label>
      <label>Jabatan<input type="text" name="role" value={editing?.role || ''} required /></label>
      <label>Path foto (opsional)<input type="text" name="photo" value={editing?.photo || ''} /></label>
      <label>Urutan<input type="number" name="sortOrder" value={editing?.sortOrder ?? items.length + 1} /></label>
      <label><input type="checkbox" name="published" checked={editing ? editing.published : true} /> Publikasikan</label>
      <p style="margin-top:1rem">
        <button class="btn btn-primary" type="submit">{editing ? 'Update' : 'Tambah'}</button>
        {editing && <a class="btn btn-outline-dark" href="/admin/people">Batal</a>}
      </p>
    </form>
    <div class="admin-card">
      <table class="admin-table">
        <thead><tr><th>Nama</th><th>Jabatan</th><th></th></tr></thead>
        <tbody>
          {
            items.map((item) => (
              <tr>
                <td>{item.name}</td>
                <td>{item.role}</td>
                <td>
                  <a href={`/admin/people?edit=${item.id}`}>Edit</a>
                  {' · '}
                  <form method="POST" action="/api/admin/people" style="display:inline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={item.id} />
                    <button type="submit" style="background:none;border:none;text-decoration:underline;cursor:pointer;font:inherit;padding:0">Hapus</button>
                  </form>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
