---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listPrograms } from '../../lib/content';

const programs = listPrograms();
---

<AdminLayout title="Program" active="programs">
  <form class="form admin-card" method="POST" action="/api/admin/programs" enctype="multipart/form-data">
    <h2 style="margin-top:0">Tambah program</h2>
    <label>Judul<input type="text" name="title" required /></label>
    <label>Deskripsi<textarea name="description" required /></label>
    <div class="admin-grid-2">
      <label>Urutan<input type="number" name="sortOrder" value={programs.length} /></label>
      <label>Foto<input type="file" name="imageFile" accept="image/*" /></label>
    </div>
    <button class="btn btn-primary" type="submit">Tambah</button>
  </form>

  <div class="admin-card" style="margin-top:1rem">
    <h2 style="margin-top:0">Daftar program</h2>
    {
      programs.map((item) => (
        <form class="form" method="POST" action="/api/admin/programs" enctype="multipart/form-data" style="border-top:1px solid var(--line);padding-top:1rem;margin-top:1rem">
          <input type="hidden" name="id" value={item.id} />
          <div class="admin-grid-2">
            <label>Judul<input type="text" name="title" value={item.title} required /></label>
            <label>Urutan<input type="number" name="sortOrder" value={item.sortOrder} /></label>
          </div>
          <label>Deskripsi<textarea name="description" required>{item.description}</textarea></label>
          <div class="admin-grid-2">
            <label>Path gambar<input type="text" name="image" value={item.image} /></label>
            <label>Ganti foto<input type="file" name="imageFile" accept="image/*" /></label>
          </div>
          {item.image && <img src={item.image} alt="" width="120" style="object-fit:cover;border-radius:.5rem" />}
          <div style="display:flex;gap:.5rem;margin-top:.75rem">
            <button class="btn btn-primary" type="submit">Simpan</button>
            <button class="btn btn-outline" type="submit" name="action" value="delete" formnovalidate onclick="return confirm('Hapus program ini?')">Hapus</button>
          </div>
        </form>
      ))
    }
  </div>
</AdminLayout>
