---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getTestimonials } from '../../lib/content';

const items = getTestimonials();
const editId = Number(Astro.url.searchParams.get('edit') || 0);
const editing = items.find((i) => i.id === editId) || null;
---

<AdminLayout title="Testimoni" active="testimonials">
  <div class="admin-grid-2">
    <form class="form admin-card" method="POST" action="/api/admin/testimonials">
      <input type="hidden" name="id" value={editing?.id || ''} />
      <h2 style="margin-top:0">{editing ? 'Edit testimoni' : 'Tambah testimoni'}</h2>
      <label>Nama<input type="text" name="name" value={editing?.name || ''} required /></label>
      <label>Peran / pekerjaan<input type="text" name="role" value={editing?.role || ''} /></label>
      <label>Kutipan<textarea name="quote" rows="4" required>{editing?.quote || ''}</textarea></label>
      <label>Urutan<input type="number" name="sortOrder" value={editing?.sortOrder ?? items.length + 1} /></label>
      <label><input type="checkbox" name="published" checked={editing ? editing.published : true} /> Publikasikan</label>
      <p style="margin-top:1rem">
        <button class="btn btn-primary" type="submit">{editing ? 'Update' : 'Tambah'}</button>
        {editing && <a class="btn btn-outline-dark" href="/admin/testimonials">Batal</a>}
      </p>
    </form>
    <div class="admin-card">
      <table class="admin-table">
        <thead><tr><th>Nama</th><th>Status</th><th></th></tr></thead>
        <tbody>
          {
            items.map((item) => (
              <tr>
                <td>
                  <strong>{item.name}</strong>
                  <div style="color:var(--muted);font-size:.85rem">{item.role}</div>
                </td>
                <td>{item.published ? 'Publik' : 'Draft'}</td>
                <td>
                  <a href={`/admin/testimonials?edit=${item.id}`}>Edit</a>
                  {' · '}
                  <form method="POST" action="/api/admin/testimonials" style="display:inline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={item.id} />
                    <button type="submit" class="linkish">Hapus</button>
                  </form>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<style>
  .linkish {
    background: none;
    border: none;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }
</style>
