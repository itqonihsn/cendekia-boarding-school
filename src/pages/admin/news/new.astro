---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminDetailFields from '../../../components/AdminDetailFields.astro';

const today = new Date().toISOString().slice(0, 10);
---

<AdminLayout title="Berita Baru" active="news">
  <form class="form admin-card" method="POST" action="/api/admin/news" enctype="multipart/form-data">
    <input type="hidden" name="returnTo" value="/admin/news" />
    <label>Judul<input type="text" name="title" required /></label>
    <div class="admin-grid-3">
      <label>Kategori<input type="text" name="category" placeholder="Pendidikan" /></label>
      <label>Tanggal<input type="date" name="publishedAt" value={today} required /></label>
    </div>
    <AdminDetailFields
      slug=""
      excerpt=""
      body=""
      coverImage=""
      videoKind="none"
      videoUrl=""
      videoPath=""
      published={true}
    />
    <button class="btn btn-primary" type="submit">Simpan berita</button>
  </form>
</AdminLayout>
