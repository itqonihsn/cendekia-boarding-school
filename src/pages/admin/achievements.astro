---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAchievements } from '../../lib/content';

const items = getAchievements();
const editId = Number(Astro.url.searchParams.get('edit') || 0);
const editing = items.find((i) => i.id === editId) || null;
---

<AdminLayout title="Prestasi" active="achievements">
  <div class="admin-grid-2">
    <form class="form admin-card" method="POST" action="/api/admin/achievements">
      <input type="hidden" name="id" value={editing?.id || ''} />
      <h2 style="margin-top:0">{editing ? 'Edit prestasi' : 'Tambah prestasi'}</h2>
      <label>Judul<input type="text" name="title" value={editing?.title || ''} required /></label>
      <label>
        Jenis
        <select name="kind">
          <option value="external" selected={editing?.kind !== 'internal'}>Eksternal</option>
          <option value="internal" selected={editing?.kind === 'internal'}>Internal</option>
        </select>
      </label>
      <label>Tahun<input type="text" name="year" value={editing?.year || ''} /></label>
      <label>Urutan<input type="number" name="sortOrder" value={editing?.sortOrder ?? items.length + 1} /></label>
      <label><input type="checkbox" name="published" checked={editing ? editing.published : true} /> Publikasikan</label>
      <p style="margin-top:1rem">
        <button class="btn btn-primary" type="submit">{editing ? 'Update' : 'Tambah'}</button>
        {editing && <a class="btn btn-outline-dark" href="/admin/achievements">Batal</a>}
      </p>
    </form>
    <div class="admin-card">
      <table class="admin-table">
        <thead><tr><th>Judul</th><th>Jenis</th><th></th></tr></thead>
        <tbody>
          {
            items.map((item) => (
              <tr>
                <td>{item.title}{item.year ? ` (${item.year})` : ''}</td>
                <td>{item.kind === 'external' ? 'Eksternal' : 'Internal'}</td>
                <td>
                  <a href={`/admin/achievements?edit=${item.id}`}>Edit</a>
                  {' · '}
                  <form method="POST" action="/api/admin/achievements" style="display:inline">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="id" value={item.id} />
                    <button type="submit" style="background:none;border:none;text-decoration:underline;cursor:pointer;font:inherit;padding:0">Hapus</button>
                  </form>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
