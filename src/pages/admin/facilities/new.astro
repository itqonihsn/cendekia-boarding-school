---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminDetailFields from '../../../components/AdminDetailFields.astro';
---

<AdminLayout title="Fasilitas Baru" active="facilities">
  <form class="form admin-card" method="POST" action="/api/admin/facilities" enctype="multipart/form-data">
    <input type="hidden" name="returnTo" value="/admin/facilities" />
    <label>Judul<input type="text" name="title" required /></label>
    <label>Urutan tampil<input type="number" name="sortOrder" value="0" /></label>
    <AdminDetailFields
      slug=""
      excerpt=""
      body=""
      coverImage=""
      videoKind="none"
      videoUrl=""
      videoPath=""
      published={true}
      excerptLabel="Ringkasan (kartu di halaman fasilitas)"
    />
    <button class="btn btn-primary" type="submit">Simpan fasilitas</button>
  </form>
</AdminLayout>
