---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageHero, getSiteSettings } from '../lib/content';
import { whatsappChatUrl, whatsappDigits } from '../lib/whatsapp';

const site = getSiteSettings();
const hero = getPageHero('kontak');
const waDefault = whatsappChatUrl(
  site.phone,
  `Assalamu'alaikum, saya ingin bertanya terkait ${site.shortName}.`,
);
const waMeBase = whatsappDigits(site.phone);
---

<BaseLayout
  title="Kontak & Pendaftaran"
  description={`Hubungi ${site.name} untuk informasi dan pendaftaran santri baru.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p>{hero.subtitle}</p>
      {
        waDefault && (
          <p class="hero-wa" style="margin-top:1.25rem">
            <a class="btn btn-yellow wa-btn" href={waDefault} target="_blank" rel="noopener noreferrer">
              Chat WhatsApp
            </a>
          </p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="info-item">
        <h3>Informasi Kontak</h3>
        <div class="contact-list" style="margin-top:1rem">
          <div class="contact-row">
            <strong>Alamat</strong>
            <span>{site.address}</span>
          </div>
          <div class="contact-row">
            <strong>Email</strong>
            <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
          </div>
          <div class="contact-row">
            <strong>WhatsApp</strong>
            <span>
              {
                waDefault ? (
                  <a class="wa-link" href={waDefault} target="_blank" rel="noopener noreferrer">
                    {site.phone}
                  </a>
                ) : (
                  site.phone
                )
              }
            </span>
          </div>
          <div class="contact-row">
            <strong>Telepon</strong>
            <span><a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></span>
          </div>
          <div class="contact-row">
            <strong>Jam Layanan</strong>
            <span>{site.hours}</span>
          </div>
        </div>
        {
          waDefault && (
            <p style="margin-top:1.25rem">
              <a class="btn btn-primary wa-btn" href={waDefault} target="_blank" rel="noopener noreferrer">
                Buka chat WhatsApp
              </a>
            </p>
          )
        }
      </div>

      <div class="info-item">
        <h3>Kirim pesan via WhatsApp</h3>
        <p class="lead" style="margin-top:0.5rem;font-size:0.95rem">
          Isi formulir di bawah — pesan akan terbuka di WhatsApp (Web atau aplikasi) siap dikirim.
        </p>
        <form class="form wa-compose" style="margin-top:1rem" id="form-wa">
          <label>
            Nama
            <input type="text" name="nama" required placeholder="Nama lengkap" autocomplete="name" />
          </label>
          <label>
            Email (opsional)
            <input type="email" name="email" placeholder="email@contoh.com" autocomplete="email" />
          </label>
          <label>
            Perihal
            <select name="perihal" required>
              <option value="">Pilih perihal</option>
              <option>Info Pendaftaran</option>
              <option>Kunjungan</option>
              <option>Kerja Sama</option>
              <option>Lainnya</option>
            </select>
          </label>
          <label>
            Pesan
            <textarea name="pesan" required placeholder="Tuliskan pesan Anda" rows="4"></textarea>
          </label>
          <button class="btn btn-primary wa-btn" type="submit">Kirim lewat WhatsApp</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

{
  waDefault && (
    <script is:inline define:vars={{ waBase: waMeBase ? `https://wa.me/${waMeBase}` : '', siteName: site.shortName }}>
      function buildWaText(form) {
        const fd = new FormData(form);
        const nama = String(fd.get('nama') || '').trim();
        const email = String(fd.get('email') || '').trim();
        const perihal = String(fd.get('perihal') || '').trim();
        const pesan = String(fd.get('pesan') || '').trim();
        const lines = [
          `Assalamu'alaikum, saya ${nama}.`,
          perihal ? `Perihal: ${perihal}` : '',
          pesan ? `\n${pesan}` : '',
          email ? `\nEmail: ${email}` : '',
          `\n— via website ${siteName}`,
        ].filter(Boolean);
        return lines.join('\n');
      }

      document.getElementById('form-wa')?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!waBase) return;
        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement)) return;
        const url = new URL(waBase);
        url.searchParams.set('text', buildWaText(form));
        window.open(url.toString(), '_blank', 'noopener,noreferrer');
      });
    </script>
  )
}

<style>
  .wa-link {
    font-weight: 600;
    color: var(--green-800);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .wa-btn {
    gap: 0.5rem;
  }

