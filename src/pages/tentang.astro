---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Tentang Kami"
  description={`Profil, visi, misi, dan nilai-nilai ${site.name}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Profil Lembaga</span>
      <h1>Tentang Kami</h1>
      <p>Mengenal lebih dekat semangat, arah, dan nilai yang menjiwai {site.name}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="section-head">
          <span class="eyebrow">Siapa Kami</span>
          <h2>Memadukan Tradisi Pesantren &amp; Pendidikan Modern</h2>
          <p class="lead">
            Kami adalah rumah belajar bagi generasi muslim yang ingin tumbuh dalam ilmu, iman, dan
            akhlak. Pendekatan boarding membuat pembinaan berlangsung utuh — di kelas maupun dalam
            kehidupan sehari-hari.
          </p>
          <p class="lead"><strong>{site.foundation}</strong> mengelola {site.fullName}.</p>
        </div>
      </div>
      <div class="panel" role="img" aria-label="Logo Cendekia Boarding School">
        <img class="panel-logo" src={site.logo} alt={site.name} />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container info-grid">
      <article class="info-item">
        <h3>Visi</h3>
        <p>
          Menjadi pesantren unggulan yang mencetak generasi muslim berilmu, berakhlak karimah, dan
          berdaya saing global.
        </p>
      </article>
      <article class="info-item">
        <h3>Misi</h3>
        <ul class="check-list">
          <li>Menyelenggarakan pendidikan Islam yang utuh dan relevan</li>
          <li>Membangun budaya Qur’ani dalam kehidupan santri</li>
          <li>Mengembangkan potensi akademik dan non-akademik</li>
          <li>Menumbuhkan kemandirian, kepemimpinan, dan kepedulian sosial</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Nilai Inti</span>
        <h2>Iman · Ilmu · Akhlak</h2>
      </div>
      <div class="feature-grid">
        <article class="feature-item">
          <div class="feature-icon">I</div>
          <h3>Iman</h3>
          <p>Setiap aktivitas diarahkan untuk memperkokoh keimanan dan ketakwaan.</p>
        </article>
        <article class="feature-item">
          <div class="feature-icon">II</div>
          <h3>Ilmu</h3>
          <p>Belajar menjadi budaya, bukan sekadar kewajiban formal.</p>
        </article>
        <article class="feature-item">
          <div class="feature-icon">III</div>
          <h3>Akhlak</h3>
          <p>Adab menjadi mahkota ilmu dalam interaksi santri, guru, dan masyarakat.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
