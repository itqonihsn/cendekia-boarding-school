---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings, getTentangContent } from '../lib/content';

const site = getSiteSettings();
const t = getTentangContent();
---

<BaseLayout
  title="Tentang Kami"
  description={`Profil, visi, misi, dan nilai-nilai ${site.name}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1>{t.hero.title}</h1>
      <p>{t.hero.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <div class="section-head">
          <span class="eyebrow">{t.whoEyebrow}</span>
          <h2>{t.whoTitle}</h2>
          <p class="lead">{t.whoLead}</p>
          <p class="lead"><strong>{t.whoFoundationNote}</strong></p>
        </div>
      </div>
      <div class="panel" role="img" aria-label="Logo Cendekia Boarding School">
        <img class="panel-logo" src={site.logo} alt={site.name} />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container info-grid">
      <article class="info-item">
        <h3>{t.visionTitle}</h3>
        <p>{t.visionText}</p>
      </article>
      <article class="info-item">
        <h3>{t.missionTitle}</h3>
        <ul class="check-list">
          {t.missionItems.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">{t.valuesEyebrow}</span>
        <h2>{t.valuesTitle}</h2>
      </div>
      <div class="feature-grid">
        {
          t.values.map((v) => (
            <article class="feature-item">
              <div class="feature-icon">{v.label}</div>
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
