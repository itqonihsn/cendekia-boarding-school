---
import BaseLayout from '../layouts/BaseLayout.astro';
import { programs, site } from '../data/site';
---

<BaseLayout
  title="Program Pendidikan"
  description={`Program unggulan ${site.name}: tahfidz, akademik, bahasa, kitab, dan pengembangan karakter.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Kurikulum &amp; Kegiatan</span>
      <h1>Program Pendidikan</h1>
      <p>Rangkaian program yang membentuk santri secara utuh — spiritual, intelektual, dan karakter.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {
          programs.map((item, i) => (
            <article class="feature-item">
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </article>
          ))
        }
      </div>
      <p style="text-align:center;margin-top:2rem">
        <a class="btn btn-primary" href="/kontak">Tanya Program &amp; Pendaftaran</a>
      </p>
    </div>
  </section>
</BaseLayout>
