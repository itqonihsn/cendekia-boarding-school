---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageHero, getSiteSettings, listPrograms } from '../lib/content';

const site = getSiteSettings();
const hero = getPageHero('program');
const programs = listPrograms();
---

<BaseLayout
  title="Program Pendidikan"
  description={`Program unggulan ${site.name}: tahfidz, akademik, bahasa, kitab, dan pengembangan karakter.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p>{hero.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-grid">
        {
          programs.map((item, i) => (
            <article class="feature-item">
              {item.image && <img src={item.image} alt="" class="feature-thumb" loading="lazy" />}
              <div class="feature-icon">{String(i + 1).padStart(2, '0')}</div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
      <p style="text-align:center;margin-top:2rem">
        <a class="btn btn-primary" href="/kontak">Tanya Program &amp; Pendaftaran</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-thumb {
    width: 100%;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
</style>
