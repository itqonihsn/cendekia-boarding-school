---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleDetail from '../../components/ArticleDetail.astro';
import { getNewsBySlug } from '../../lib/content';

const slug = Astro.params.slug!;
const article = getNewsBySlug(slug);
if (!article) return Astro.redirect('/berita');

const meta = `${article.category} · ${article.publishedAt}`;
---

<BaseLayout
  title={article.title}
  description={article.excerpt}
  canonical={`/berita/${article.slug}`}
>
  <ArticleDetail
    title={article.title}
    meta={meta}
    coverImage={article.coverImage}
    videoKind={article.videoKind}
    videoUrl={article.videoUrl}
    videoPath={article.videoPath}
    body={article.body}
    backHref="/berita"
    backLabel="← Kembali ke berita"
  />
</BaseLayout>
