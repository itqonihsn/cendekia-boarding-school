---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageHero, getSiteSettings, listNews } from '../lib/content';

const site = getSiteSettings();
const hero = getPageHero('berita');
const news = listNews(true);
---

<BaseLayout
  title="Berita & Kegiatan"
  description={`Berita dan kegiatan terbaru dari ${site.name}.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.title}</h1>
      <p>{hero.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="news-grid">
        {
          news.map((item) => (
            <article class="news-item" id={item.slug}>
              {item.coverImage && <img src={item.coverImage} alt="" class="news-cover" loading="lazy" />}
              <div class="news-meta">
                <span>{item.category}</span>
                <time datetime={item.publishedAt}>{item.publishedAt}</time>
              </div>
              <h3><a href={`/berita/${item.slug}`}>{item.title}</a></h3>
              <p>{item.excerpt}</p>
              <p><a class="btn btn-outline-dark" href={`/berita/${item.slug}`}>Baca selengkapnya</a></p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .news-cover {
    width: 100%;
    border-radius: 0.75rem;
    margin-bottom: 0.75rem;
    aspect-ratio: 16/10;
    object-fit: cover;
  }
</style>
