---
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  active?: string;
}

const { title, active = '' } = Astro.props;

const links = [
  { href: '/admin', label: 'Dashboard', key: 'dashboard' },
  { href: '/admin/settings', label: 'Pengaturan Situs', key: 'settings' },
  { href: '/admin/home', label: 'Beranda', key: 'home' },
  { href: '/admin/tentang', label: 'Tentang', key: 'tentang' },
  { href: '/admin/pages', label: 'Hero Halaman', key: 'pages' },
  { href: '/admin/programs', label: 'Program', key: 'programs' },
  { href: '/admin/facilities', label: 'Fasilitas', key: 'facilities' },
  { href: '/admin/news', label: 'Berita', key: 'news' },
  { href: '/admin/media', label: 'Media', key: 'media' },
];

const saved = Astro.url.searchParams.get('saved') === '1';
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin CBS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js" defer></script>
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <h1>Admin CBS</h1>
        <p>Panel kelola website</p>
        <nav class="admin-nav" aria-label="Menu admin">
          {
            links.map((link) => (
              <a href={link.href} class:list={[{ active: active === link.key }]}>{link.label}</a>
            ))
          }
        </nav>
        <form method="POST" action="/api/admin/logout" style="margin-top:1.5rem">
          <button class="btn btn-outline" type="submit" style="width:100%;color:white;border-color:rgba(255,255,255,.35)">
            Keluar
          </button>
        </form>
        <p style="margin-top:1rem;font-size:.75rem;opacity:.75">
          <a href="/" style="color:var(--yellow-400)">Lihat website</a>
        </p>
      </aside>
      <main class="admin-main">
        <div class="admin-top">
          <h1 style="margin:0;font-size:clamp(1.4rem,3vw,1.9rem)">{title}</h1>
        </div>
        {saved && <div class="admin-flash">Perubahan berhasil disimpan.</div>}
        {error && <div class="admin-flash error">{error}</div>}
        <slot />
      </main>
    </div>
    <script is:inline>
      function syncQuillToHidden(quill, hidden) {
        const html = quill.root.innerHTML.trim();
        hidden.value = html === '<p><br></p>' ? '' : html;
      }

      function initAdminQuills() {
        if (typeof Quill === 'undefined') return;
        document.querySelectorAll('.quill-mount:not([data-ready])').forEach((mount) => {
          mount.dataset.ready = '1';
          const form = mount.closest('form');
          const field = mount.dataset.field;
          const hidden = form?.querySelector(`textarea[name="${field}"]`);
          if (!hidden) return;

          const quill = new Quill(mount, {
            theme: 'snow',
            modules: {
              toolbar: [
                [{ header: [2, 3, false] }],
                ['bold', 'italic', 'underline'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['link', 'blockquote'],
                ['clean'],
              ],
            },
          });

          const initial = mount.dataset.initial || '';
          if (initial.trim()) {
            quill.clipboard.dangerouslyPasteHTML(initial);
          }
          syncQuillToHidden(quill, hidden);

          quill.on('text-change', () => syncQuillToHidden(quill, hidden));

          form?.addEventListener(
            'submit',
            (event) => {
              syncQuillToHidden(quill, hidden);
              const required = mount.dataset.required === '1';
              const empty = !quill.getText().trim();
              if (required && empty) {
                event.preventDefault();
                quill.focus();
                alert('Mohon isi deskripsi lengkap.');
              }
            },
            { capture: true },
          );
        });
      }

      function bootQuill() {
        if (typeof Quill !== 'undefined') {
          initAdminQuills();
        } else {
          window.addEventListener('load', initAdminQuills, { once: true });
        }
      }

      bootQuill();
      document.addEventListener('astro:page-load', bootQuill);
    </script>
  </body>
</html>
