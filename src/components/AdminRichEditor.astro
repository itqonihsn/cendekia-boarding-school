---
interface Props {
  name: string;
  label: string;
  value?: string;
  required?: boolean;
}

const { name, label, value = '', required = false } = Astro.props;
const fieldId = `editor-${name}`;
---

<label class="rich-field">
  {label}
  <div
    id={fieldId}
    class="quill-mount"
    data-field={name}
    data-initial={value}
    data-required={required ? '1' : '0'}
  ></div>
  <textarea name={name} class="quill-hidden" aria-hidden="true"></textarea>
</label>

<style>
  .rich-field {
    display: block;
    margin-bottom: 1rem;
  }

  .quill-mount {
    background: #fff;
    border-radius: 0.75rem;
    min-height: 200px;
  }

  .quill-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .rich-field :global(.ql-toolbar) {
    border-radius: 0.75rem 0.75rem 0 0;
    border-color: var(--line);
  }

  .rich-field :global(.ql-container) {
    border-radius: 0 0 0.75rem 0.75rem;
    border-color: var(--line);
    font-size: 1rem;
    min-height: 160px;
  }
</style>
