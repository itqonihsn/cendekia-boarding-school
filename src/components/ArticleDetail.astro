---
import { renderArticleBody } from '../lib/body';
import { youtubeEmbedUrl } from '../lib/youtube';

export type VideoKind = 'none' | 'youtube' | 'upload';

interface Props {
  title: string;
  meta?: string;
  coverImage?: string;
  videoKind?: VideoKind;
  videoUrl?: string;
  videoPath?: string;
  body: string;
  backHref: string;
  backLabel: string;
}

const {
  title,
  meta,
  coverImage,
  videoKind = 'none',
  videoUrl = '',
  videoPath = '',
  body,
  backHref,
  backLabel,
} = Astro.props;

const html = renderArticleBody(body);
const embed = videoKind === 'youtube' ? youtubeEmbedUrl(videoUrl) : null;
---

<article class="section">
  <div class="container article-wrap">
    {meta && <p class="news-meta">{meta}</p>}
    <h1>{title}</h1>
    {coverImage && <img class="article-cover" src={coverImage} alt="" loading="lazy" />}
    {
      embed && (
        <div class="video-embed">
          <iframe
            src={embed}
            title={title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      )
    }
    {videoKind === 'upload' && videoPath && (
      <video class="article-video" src={videoPath} controls preload="metadata" />
    )}
    <div class="article-body" set:html={html} />
    <p class="article-back">
      <a class="btn btn-outline-dark" href={backHref}>{backLabel}</a>
    </p>
  </div>
</article>

<style>
  .article-wrap {
    max-width: 46rem;
  }

  .article-wrap h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1rem;
  }

  .article-cover {
    width: 100%;
    border-radius: 1rem;
    margin: 1rem 0 1.5rem;
    aspect-ratio: 16/9;
    object-fit: cover;
  }

  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    margin: 1rem 0 1.5rem;
    border-radius: 1rem;
    overflow: hidden;
    background: #000;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .article-video {
    width: 100%;
    border-radius: 1rem;
    margin: 1rem 0 1.5rem;
  }

  .article-body :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    margin: 1.5rem 0 0.75rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1rem 1.25rem;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  .article-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1rem;
  }

  .article-body :global(pre),
  .article-body :global(iframe) {
    max-width: 100%;
    overflow-x: auto;
  }

  .article-back {
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .article-wrap {
      padding-bottom: env(safe-area-inset-bottom);
    }

    .article-wrap h1 {
      font-size: clamp(1.65rem, 6.5vw, 2rem);
    }

    .article-back .btn {
      width: 100%;
    }

    .article-video {
      max-height: min(56vw, 320px);
      width: 100%;
      object-fit: contain;
      background: #000;
    }
  }
</style>
