---
import type { SiteSettings } from '../lib/types';
import { whatsappChatUrl } from '../lib/whatsapp';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const waUrl = whatsappChatUrl(site.phone);
const phoneDisplay = site.phone.replace(/^\+62\s?/, '0').replace(/\s|-/g, '') || site.phone;
---

<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="brand" href="/">
          <img src={site.logo || '/logo-cbs.png'} alt={site.name} width="48" height="48" />
          <span>
            <small>Pesantren Modern Terpadu</small>
            <b>SMP Cendekia Boarding School</b>
          </span>
        </a>
        <p style="margin-top:14px">{site.address}</p>
      </div>
      <div>
        <h4>PPDB</h4>
        <ul>
          <li><a href="/#alur">Alur pendaftaran</a></li>
          <li><a href="/#biaya">Biaya dan jadwal</a></li>
          <li><a href="/kontak">Persyaratan</a></li>
          <li><a href="/kontak">Cek status</a></li>
        </ul>
      </div>
      <div>
        <h4>Kontak</h4>
        <ul>
          <li>
            {
              waUrl ? (
                <a href={waUrl} target="_blank" rel="noopener noreferrer">
                  Contact person: {phoneDisplay}
                </a>
              ) : (
                <>Contact person: {phoneDisplay}</>
              )
            }
          </li>
          <li>{site.domain.replace(/^https?:\/\//, '')}</li>
          {
            site.instagram && (
              <li>
                <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                  Instagram: cbs_bogor
                </a>
              </li>
            )
          }
          {
            site.youtube && (
              <li>
                <a href={site.youtube} target="_blank" rel="noopener noreferrer">
                  YouTube: @CBS.BogorTv
                </a>
              </li>
            )
          }
          {
            site.facebook && (
              <li>
                <a href={site.facebook} target="_blank" rel="noopener noreferrer">
                  Facebook / TikTok: CBSBogor
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>
    <div class="copy">
      {site.foundation} · Al Qur'annya Oke! Akademiknya Oke!
    </div>
  </div>
</footer>
