---
import { nav } from '../data/site';
import type { SiteSettings } from '../lib/types';
import { whatsappChatUrl } from '../lib/whatsapp';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const waUrl = whatsappChatUrl(site.phone);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/" aria-label={site.name}>
        <img class="brand-logo" src={site.logo} alt={site.name} width="64" height="64" />
        <span class="brand-text">
          <strong>{site.shortName}</strong>
          <span>{site.foundation}</span>
        </span>
      </a>
      <p>{site.tagline}</p>
    </div>
    <div>
      <h3>Menu</h3>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Kontak</h3>
      <ul>
        <li>{site.address}</li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          {
            waUrl ? (
              <a href={waUrl} target="_blank" rel="noopener noreferrer">
                WhatsApp: {site.phone}
              </a>
            ) : (
              <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>
            )
          }
        </li>
        <li>{site.hours}</li>
      </ul>
    </div>
  </div>
  <div class="container footer-copy">
    <p>© {new Date().getFullYear()} {site.name} · {site.foundation}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    background: linear-gradient(160deg, var(--green-950), var(--green-800));
    color: rgba(255, 255, 255, 0.9);
    padding: 3rem 0 calc(1.5rem + env(safe-area-inset-bottom));
    border-top: 4px solid var(--yellow-400);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .brand-logo {
    width: 58px;
    height: auto;
    aspect-ratio: 819 / 788;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.2));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: white;
  }

  .brand-text span {
    font-size: 0.78rem;
    color: var(--yellow-400);
    font-weight: 600;
  }

  h3 {
    color: var(--yellow-400);
    font-size: 1.25rem;
    margin-bottom: 0.85rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.25rem;
  }

  .footer-grid ul a,
  .footer-grid ul li {
    display: block;
    overflow-wrap: anywhere;
  }

  .footer-grid ul a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0;
  }

  @media (hover: hover) {
    a:hover {
      color: var(--yellow-400);
    }
  }

  .footer-copy {
    padding-top: 1.1rem;
  }

  .footer-copy p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .site-footer {
      padding-top: 2.5rem;
    }

    .footer-copy p {
      text-align: center;
      line-height: 1.5;
    }
  }
</style>
