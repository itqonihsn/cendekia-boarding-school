---
import AdminRichEditor from './AdminRichEditor.astro';
import AdminImageField from './AdminImageField.astro';
import type { VideoKind } from '../lib/types';

interface Props {
  slug: string;
  excerpt: string;
  body: string;
  coverImage: string;
  videoKind: VideoKind;
  videoUrl: string;
  videoPath: string;
  published: boolean;
  excerptLabel?: string;
  showPublished?: boolean;
}

const {
  slug,
  excerpt,
  body,
  coverImage,
  videoKind,
  videoUrl,
  videoPath,
  published,
  excerptLabel = 'Ringkasan (tampil di daftar)',
  showPublished = true,
} = Astro.props;
---

<label>Slug URL (opsional)<input type="text" name="slug" value={slug} placeholder="auto dari judul" /></label>
<label>{excerptLabel}<textarea name="excerpt" required rows="3">{excerpt}</textarea></label>
<AdminRichEditor name="body" label="Deskripsi lengkap" value={body} required />
<AdminImageField
  label="Foto sampul"
  pathName="coverImage"
  fileName="coverFile"
  clearName="clearCoverImage"
  value={coverImage}
  hint="Upload file baru untuk mengganti foto. Centang hapus untuk menampilkan tanpa foto."
/>

<fieldset class="admin-media-field">
  <legend>Video</legend>
  <label>Jenis video
    <select name="videoKind">
      <option value="none" selected={videoKind === 'none'}>Tanpa video</option>
      <option value="youtube" selected={videoKind === 'youtube'}>YouTube</option>
      <option value="upload" selected={videoKind === 'upload'}>Upload file</option>
    </select>
  </label>
  <label>URL YouTube
    <input type="text" name="videoUrl" value={videoUrl} inputmode="url" autocomplete="off" placeholder="https://www.youtube.com/watch?v=..." />
  </label>
  <p class="admin-media-hint">Kosongkan URL lalu simpan untuk menghapus video YouTube.</p>
  <input type="hidden" name="videoPath" value={videoPath} />
  {videoPath ? (
    <>
      <div class="admin-media-preview admin-media-preview--video">
        <video src={videoPath} controls preload="metadata" />
      </div>
      <label>Ganti — upload video baru
        <input type="file" name="videoFile" accept="video/*" />
      </label>
      <label class="admin-media-clear">
        <input type="checkbox" name="clearVideoUpload" /> Hapus video file (kosongkan)
      </label>
    </>
  ) : (
    <label>Upload video
      <input type="file" name="videoFile" accept="video/*" />
    </label>
  )}
</fieldset>
{
  showPublished && (
    <label style="display:flex;align-items:center;gap:.5rem">
      <input type="checkbox" name="published" checked={published} /> Tampilkan di website publik
    </label>
  )
}
