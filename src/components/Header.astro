---
import type { SiteSettings } from '../lib/types';
import { waHref, waLinkAttrs, whatsappRegistrationUrl } from '../lib/whatsapp';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const waHubungi = whatsappRegistrationUrl(site.phone, site.shortName);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/tentang', label: 'Profil' },
  { href: '/program', label: 'Program' },
  { href: '/fasilitas', label: 'Fasilitas' },
  { href: '/berita', label: 'Prestasi' },
  { href: '/#biaya', label: 'PPDB' },
  { href: '/kontak', label: 'Kontak' },
];

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  return pathname === clean;
}
---

<header class="site-header">
  <div class="wrap">
    <nav class="nav" aria-label="Navigasi utama">
      <a class="brand" href="/" aria-label={site.name}>
        <img src={site.logo || '/logo-cbs.png'} alt={site.name} width="48" height="48" />
        <span>
          <small>Pesantren Modern Terpadu</small>
          <b>SMP Cendekia Boarding School</b>
        </span>
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav-list"
        data-nav-toggle
      >
        <span class="sr-only">Buka menu</span>
        <span></span><span></span><span></span>
      </button>

      <ul id="site-nav-list" data-nav>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class:list={[{ on: isActive(item.href) }]} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-gold" href={waHref(waHubungi)} {...waLinkAttrs(waHubungi)} data-nav-link>
        Daftar PPDB
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 16px 0 8px;
    background: linear-gradient(180deg, var(--surface-sky), rgba(243, 248, 254, 0.92));
    backdrop-filter: blur(8px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--sky-100);
    border-radius: var(--radius-pill);
    margin-left: auto;
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    background: var(--navy-900);
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: inline-block;
    }
    .nav ul {
      display: none;
      position: absolute;
      left: 1rem;
      right: 1rem;
      top: 78px;
      background: var(--surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      padding: 12px;
      flex-direction: column;
    }
    body.nav-open .nav ul {
      display: flex;
    }
    .nav .btn-gold {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('click', (e) => {
    const toggle = e.target.closest('[data-nav-toggle]');
    if (toggle) {
      const open = document.body.classList.toggle('nav-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      return;
    }
    if (e.target.closest('[data-nav-link]')) {
      document.body.classList.remove('nav-open');
    }
  });
</script>
