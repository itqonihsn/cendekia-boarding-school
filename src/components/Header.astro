---
import { nav } from '../data/site';
import type { SiteSettings } from '../lib/types';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  return pathname === clean;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={site.name}>
      <img class="brand-logo" src={site.logo} alt={site.name} width="56" height="56" />
      <span class="brand-text">
        <strong>{site.shortName}</strong>
        <span>{site.foundation}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="sr-only">Buka menu</span>
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav aria-label="Navigasi utama">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class:list={[{ active: isActive(item.href) }]} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-primary nav-cta" href="/kontak" data-nav-link>Hubungi Kami</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(255, 253, 245, 0.94);
    border-bottom: 2px solid rgba(46, 175, 58, 0.2);
    padding-top: env(safe-area-inset-top);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--site-header-h, 4.6rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
  }

  .brand-logo {
    width: 52px;
    height: auto;
    aspect-ratio: 819 / 788;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 10px rgba(20, 90, 31, 0.18));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.12rem;
    color: var(--green-900);
  }

  .brand-text span {
    font-size: 0.72rem;
    color: var(--muted);
    font-weight: 600;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.94rem;
  }

  .site-nav a.active {
    background: rgba(255, 230, 0, 0.45);
    color: var(--green-900);
  }

  @media (hover: hover) {
    .site-nav a:hover {
      background: rgba(46, 175, 58, 0.12);
      color: var(--green-900);
    }
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: white;
    padding: 0.7rem;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
  }

  .nav-toggle span:not(.sr-only) {
    display: block;
    height: 2px;
    background: var(--green-800);
    border-radius: 99px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 900px) {
    .brand {
      flex: 1;
      min-width: 0;
    }

    .brand-text strong {
      font-size: clamp(0.88rem, 3.5vw, 0.95rem);
      max-width: 14ch;
      overflow-wrap: anywhere;
    }

    .brand-text span {
      font-size: 0.65rem;
      max-width: 22ch;
      overflow-wrap: anywhere;
    }

    .brand-logo {
      width: 44px;
    }

    .nav-toggle {
      display: inline-flex;
      flex-shrink: 0;
    }

    .site-nav {
      position: fixed;
      left: 0;
      right: 0;
      top: calc(var(--site-header-h, 4.6rem) + env(safe-area-inset-top));
      bottom: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      padding: 1rem 1rem calc(1.25rem + env(safe-area-inset-bottom));
      background: rgba(255, 253, 245, 0.98);
      border: none;
      border-top: 2px solid rgba(46, 175, 58, 0.2);
      border-radius: 0;
      box-shadow: none;
      max-height: none;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      z-index: 49;
    }

    .site-nav.open {
      display: flex;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }

    .site-nav a {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 0.75rem;
      font-size: 1rem;
    }

    .nav-cta {
      width: 100%;
      margin-top: 0.35rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  const links = document.querySelectorAll('[data-nav-link]');

  function setOpen(open) {
    nav?.classList.toggle('open', open);
    document.body.classList.toggle('nav-open', open);
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('open');
    setOpen(open);
  });

  links.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  document.addEventListener('click', (event) => {
    if (!nav?.classList.contains('open')) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (nav.contains(target) || toggle?.contains(target)) return;
    setOpen(false);
  });

  window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
