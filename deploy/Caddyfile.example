# Cendekia Boarding School — Astro SSR + admin CMS
#
# Caddy SNAP (Ubuntu): edit file INI (bukan hanya .../current/Caddyfile):
#   sudo nano /var/snap/caddy/common/caddy/Caddyfile
# Lalu:
#   sudo snap run caddy validate --config /var/snap/caddy/common/caddy/Caddyfile
#   sudo snap restart caddy
#
# WAJIB: PM2 menjalankan Node di 127.0.0.1:4321

# Jika reload Caddy gagal / masih 404, pakai deploy/Caddyfile.minimal dulu.

cendekiaboardingschool.id, www.cendekiaboardingschool.id {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4321
}
