# Cendekia Boarding School — Astro SSR + admin CMS
#
# Caddy SNAP: `validate` saja TIDAK cukup — service pakai JSON dari:
#   sudo snap set caddy config='...'
# Workflow:
#   sudo mkdir -p /var/snap/caddy/common/caddy
#   sudo nano /var/snap/caddy/common/caddy/Caddyfile   # isi di bawah
#   bash deploy/fix-caddy-snap.sh   (di VPS, dari repo atau copy script)
#
# WAJIB: PM2 menjalankan Node di 127.0.0.1:4321

# Jika reload Caddy gagal / masih 404, pakai deploy/Caddyfile.minimal dulu.

cendekiaboardingschool.id, www.cendekiaboardingschool.id {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4321
}
