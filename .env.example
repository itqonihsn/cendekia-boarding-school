# Domain production (build / canonical)
SITE_URL=https://cendekiaboardingschool.id

# Server (Node SSR)
HOST=0.0.0.0
PORT=4321

# CMS — simpan database & upload di folder persisten (VPS: di luar folder deploy)
DATA_DIR=./data

# Admin (password awal hanya saat database pertama kali dibuat)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# Wajib di production (min. 16 karakter)
SESSION_SECRET=ganti-dengan-string-acak-panjang
